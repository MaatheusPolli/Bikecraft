# Copie este arquivo para .env e preencha com seus dados reais.
# O arquivo .env está no .gitignore e nunca deve ser versionado.

# Nome e URL exibidos nos e-mails
SITE_NAME=Bikcraft
SITE_URL=www.bikcraft.com

# Escolha o método de envio: smtp (PHPMailer) ou sendgrid
# (o formulário usa enviar.php para smtp e enviar-sendgrid.php para sendgrid)

# SMTP (PHPMailer)
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_USER=contato@exemplo.com.br
SMTP_PASS=troque-pela-senha
SMTP_SECURE=tls

# SendGrid
SENDGRID_API_KEY=troque-pela-chave
SENDGRID_FROM=contato@exemplo.com.br
